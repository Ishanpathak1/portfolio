---
import Layout from '../layouts/Layout.astro';
const featuredProjects = [
  {
    title: 'take-my.info',
    description: 'Resume-to-portfolio platform that turns plain career data into polished personal websites in minutes.',
    stack: ['Next.js', 'TypeScript', 'Tailwind'],
    link: 'https://take-my.info'
  },
  {
    title: 'UnifiedData',
    description: 'AI-powered CSV workflow with instant dashboards and automated business reports.',
    stack: ['React', 'FastAPI', 'Python', 'Docker'],
    link: 'https://github.com/Ishanpathak1/UnifiedData',
    linkLabel: 'View Code'
  },
  {
    title: 'Varnatva',
    description: 'Blockchain-based cross-site commenting with extension support and decentralized storage.',
    stack: ['Solidity', 'JavaScript', 'Web3'],
    link: 'https://blockchain-comment.vercel.app/'
  }
];

const experience = [
  {
    company: 'Center for Human Services Research (CHSR)',
    role: '.NET Intern',
    location: 'Albany, NY',
    period: 'Oct 2025 - Present',
    highlights: [
      'Building full-stack tools with C#, SQL, JavaScript, HTML, and CSS.',
      'Contributing to documentation, testing, and security hardening.'
    ]
  },
  {
    company: 'Securr Technology',
    role: 'Front-End Engineer Intern',
    location: 'Ahmedabad, India',
    period: 'Oct 2023 - Jul 2024',
    highlights: [
      'Redesigned and shipped the company website with 25% faster load times.',
      'Collaborated in Agile workflows with CI/CD deployment pipelines.'
    ]
  }
];

const skills = [
  'JavaScript', 'TypeScript', 'Astro', 'React', 'Node.js', 'Python',
  'FastAPI', 'Tailwind CSS', 'PostgreSQL', 'MongoDB', 'Docker', 'AWS'
];
---

<Layout title="Ishan Pathak | Full-Stack Developer">
  <section class="section">
    <div class="container">
      <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <p class="chip">Full-Stack Developer • Albany, NY</p>
          <h1 class="mt-5 text-4xl font-extrabold leading-tight tracking-tight text-slate-900 md:text-6xl dark:text-slate-100">
            I build modern software experiences that feel fast and thoughtful.
          </h1>
          <p class="mt-6 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
            I am Ishan Pathak, a developer focused on product-minded engineering, clean UI systems, and practical AI features that solve real user problems.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn btn-primary" href="#projects">See Projects</a>
            <a class="btn btn-secondary" href="/IshanResume.pdf">Download Resume</a>
          </div>
        </div>

        <div class="panel p-6 md:p-8">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600 dark:text-indigo-300">Highlights</p>
          <dl class="mt-5 space-y-5">
            <div class="flex items-end justify-between border-b border-slate-200 pb-3 dark:border-slate-700">
              <dt class="text-sm text-slate-500 dark:text-slate-400">Years building on the web</dt>
              <dd class="text-2xl font-bold text-slate-900 dark:text-slate-100">3+</dd>
            </div>
            <div class="flex items-end justify-between border-b border-slate-200 pb-3 dark:border-slate-700">
              <dt class="text-sm text-slate-500 dark:text-slate-400">Shipped products</dt>
              <dd class="text-2xl font-bold text-slate-900 dark:text-slate-100">10+</dd>
            </div>
            <div class="flex items-end justify-between">
              <dt class="text-sm text-slate-500 dark:text-slate-400">Focus areas</dt>
              <dd class="text-right text-sm font-semibold text-slate-800 dark:text-slate-100">Full-stack apps<br />AI tooling<br />Performance</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section id="experience" class="section pt-0">
    <div class="container">
      <h2 class="section-title">Experience</h2>
      <p class="section-subtitle">A few places where I have delivered engineering impact recently.</p>
      <div class="mt-8 space-y-4">
        {experience.map((job) => (
          <article class="panel p-6">
            <div class="flex flex-col justify-between gap-3 md:flex-row md:items-start">
              <div>
                <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">{job.company}</h3>
                <p class="mt-1 text-sm font-medium text-indigo-600 dark:text-indigo-300">{job.role} • {job.location}</p>
              </div>
              <p class="chip">{job.period}</p>
            </div>
            <ul class="mt-4 space-y-2 text-sm text-slate-600 dark:text-slate-300">
              {job.highlights.map((point) => (
                <li>• {point}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="projects" class="section pt-0">
    <div class="container">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 class="section-title">Featured Projects</h2>
          <p class="section-subtitle">Recent products focused on usability, automation, and performance.</p>
        </div>
        <a href="/projects" class="btn btn-secondary w-fit">View All Projects</a>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {featuredProjects.map((project) => (
          <article class="panel p-6 transition-transform hover:-translate-y-1">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">{project.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{project.description}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {project.stack.map((tag) => (
                <span class="chip">{tag}</span>
              ))}
            </div>
            <a href={project.link} target="_blank" rel="noreferrer" class="mt-5 inline-flex text-sm font-semibold text-indigo-600 hover:text-indigo-500 dark:text-indigo-300 dark:hover:text-indigo-200">
              {project.linkLabel ?? 'Open Project'} →
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="skills" class="section pt-0">
    <div class="container">
      <h2 class="section-title">Skills & Toolbox</h2>
      <p class="section-subtitle">Technologies I use to design, build, and ship reliable products.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {skills.map((skill) => (
          <span class="chip text-sm">{skill}</span>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="section pt-0">
    <div class="container">
      <div class="panel p-8 md:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600 dark:text-indigo-300">Contact</p>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 md:text-4xl dark:text-slate-100">
          Let’s build something valuable together.
        </h2>
        <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-300">
          I am open to internships, full-time opportunities, and product collaborations. If you have an idea in mind, I would love to hear it.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="mailto:ishan.pathak2711@gmail.com" class="btn btn-primary">Email Me</a>
          <a href="https://www.linkedin.com/in/ishan-pathak-96852a1b7/" target="_blank" rel="noreferrer" class="btn btn-secondary">Connect on LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
