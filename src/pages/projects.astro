---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'take-my.info',
    description: 'Transform your resume into a beautiful, shareable portfolio website in one click.',
    longDescription: 'take-my.info is a smart portfolio generator that converts your resume into a stunning, personalized portfolio website instantly. Features include intelligent resume parsing, multiple themes and layouts, customizable color schemes, and one-click sharing. Built with Next.js and modern web technologies.',
    tags: ['Next.js', 'React', 'TypeScript', 'Tailwind CSS'],
    githubUrl: 'https://github.com/Ishanpathak1/portfoliome',
    liveUrl: 'https://take-my.info',
    featured: true
  },
  {
    title: 'UnifiedData',
    description: 'AI-powered CSV editor with auto dashboards and reports for data visualization.',
    longDescription: 'UnifiedData streamlines your CSV data workflow with AI-powered insights, automatic dashboard generation, and visual reporting—all in one intuitive interface. Built for data analysts and business professionals who need quick insights without complex setups.',
    tags: ['React', 'Python', 'FastAPI', 'Docker'],
    githubUrl: 'https://github.com/Ishanpathak1/UnifiedData',
    liveUrl: 'https://www.unifieddata.app/',
    featured: true
  },
  {
    title: 'Revode',
    description: 'AI memory retention tool for DSA questions to help developers practice efficiently.',
    longDescription: 'Revode uses spaced repetition and AI-driven question generation to help developers master Data Structures and Algorithms. The app tracks your progress and adapts to your learning style, ensuring efficient skill retention.',
    tags: ['React', 'JavaScript', 'OpenAI API'],
    githubUrl: 'https://github.com/Ishanpathak1/Revode',
    liveUrl: 'https://revode.vercel.app',
    featured: true
  },
  {
    title: 'BloomBot',
    description: 'Your AI companion for mental wellness and personal growth with 24/7 support in a safe space.',
    longDescription: 'BloomBot provides personalized mental wellness support through an AI companion that offers 24/7 conversation, mindfulness exercises, and growth-oriented guidance. All interactions are private and secure.',
    tags: ['React', 'AI', 'Next.js', 'Tailwind CSS'],
    githubUrl: 'https://github.com/Ishanpathak1/BloomBot',
    liveUrl: 'https://bloom-bot-psi.vercel.app/',
    featured: false
  },
  {
    title: 'AI Resume Editor',
    description: 'Create professional resumes with AI assistance to stand out in your job search.',
    longDescription: 'The AI Resume Editor helps job seekers create standout resumes with smart suggestions and formatting. Features include DOCX import, automated section marking, and real-time AI improvement suggestions tailored to your target role.',
    tags: ['React', 'AI', 'TypeScript', 'Tailwind CSS'],
    githubUrl: 'https://github.com/Ishanpathak1/ai-resume-editor',
    liveUrl: 'https://ai-resume-editor.vercel.app',
    featured: false
  },
  {
    title: 'Varnatva',
    description: 'Blockchain-based comment system with browser extension integration.',
    longDescription: 'Varnatva is a decentralized comment system built on blockchain technology that allows users to leave comments on any website. The companion browser extension makes interaction seamless while maintaining comment integrity through distributed ledger technology.',
    tags: ['Solidity', 'React', 'Javascript', 'HTML', 'CSS'],
    githubUrl: 'https://github.com/Ishanpathak1',
    liveUrl: 'https://blockchain-comment.vercel.app/',
    featured: false
  }
];

const pageDescription = "Explore Ishan Pathak's portfolio of web development and AI projects, including full-stack applications, tools, and experiments using React, JavaScript, Python, and more.";
---

<Layout 
  title="Projects Portfolio | Ishan Pathak" 
  description={pageDescription}
  canonicalURL="projects"
  image="/images/projects/meta-image.jpg"
>
  <section class="section">
    <div class="container">
      <header>
        <p class="chip">Project Library</p>
        <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-slate-900 md:text-6xl dark:text-slate-100">Selected Product Work</h1>
        <p class="mt-5 max-w-3xl text-lg text-slate-600 dark:text-slate-300">
          A curated set of web products and AI experiments I have built across full-stack engineering, UX, and automation.
        </p>
      </header>

      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {projects.map((project) => (
          <article class="panel flex h-full flex-col p-6">
            <div class="flex items-start justify-between gap-4">
              <h2 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">{project.title}</h2>
              {project.featured && <span class="chip">Featured</span>}
            </div>
            <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{project.longDescription}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="chip">{tag}</span>
              ))}
            </div>
            <div class="mt-6 flex gap-3">
              <a href={project.liveUrl} target="_blank" rel="noreferrer" class="btn btn-primary">Live Demo</a>
              <a href={project.githubUrl} target="_blank" rel="noreferrer" class="btn btn-secondary">Code</a>
            </div>
          </article>
        ))}
      </div>

      <section class="mt-10 panel p-8">
        <h2 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">How I build</h2>
        <ul class="mt-4 space-y-2 text-sm text-slate-600 dark:text-slate-300">
          <li>• Product-first planning with measurable user outcomes.</li>
          <li>• Fast interfaces backed by maintainable full-stack architecture.</li>
          <li>• AI integrations that provide practical value, not novelty.</li>
          <li>• Strong focus on accessibility, performance, and deployment quality.</li>
        </ul>
      </section>
    </div>
  </section>
</Layout> 